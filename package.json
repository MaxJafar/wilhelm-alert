{
  "name": "wilhelm-alert",
  "version": "0.5.2",
  "description": "Plays an alert sound when your coding agent (Claude Code, Codex, Antigravity, OpenClaw) finishes a task",
  "license": "Apache-2.0",
  "author": "MaxJafar",
  "homepage": "https://github.com/MaxJafar/wilhelm-alert",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxJafar/wilhelm-alert.git"
  },
  "keywords": [
    "claude-code",
    "codex",
    "claude-code-plugin",
    "codex-plugin",
    "cli",
    "notification",
    "hook",
    "agent"
  ],
  "bin": {
    "wilhelm-alert": "bin/wilhelm-alert.js",
    "wilhelm-settings": "bin/wilhelm-settings",
    "wilhelm-face": "bin/wilhelm-face",
    "wilhelm-log": "bin/wilhelm-log.js"
  },
  "scripts": {
    "setup": "./bin/wilhelm-settings",
    "face": "./bin/wilhelm-face",
    "test-alert": "./bin/wilhelm-alert",
    "build": "./bin/wilhelm-build overlay && ./bin/wilhelm-build settings",
    "postinstall": "./bin/wilhelm-build overlay >/dev/null 2>&1 || true",
    "log": "./bin/wilhelm-log"
  },
  "files": [
    ".agents",
    ".claude-plugin",
    ".codex-plugin",
    "LICENSE",
    "NOTICE",
    "README.md",
    "app",
    "assets",
    "bin",
    "hooks",
    "integrations",
    "sounds/README.md"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.34.5",
  "bugs": {
    "url": "https://github.com/MaxJafar/wilhelm-alert/issues"
  }
}
