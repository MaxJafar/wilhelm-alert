{
  "name": "wilhelm-alert",
  "version": "0.10.1",
  "description": "Plays an alert sound when your coding agent (Claude Code, Codex, Antigravity, OpenClaw) finishes a task",
  "license": "Apache-2.0",
  "author": "MaxJafar",
  "homepage": "https://github.com/MaxJafar/wilhelm-alert",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxJafar/wilhelm-alert.git"
  },
  "keywords": [
    "claude-code",
    "codex",
    "claude-code-plugin",
    "codex-plugin",
    "cli",
    "notification",
    "hook",
    "agent"
  ],
  "bin": {
    "wilhelm-alert": "bin/wilhelm-alert.js",
    "wilhelm-log": "bin/wilhelm-log.js"
  },
  "scripts": {
    "app": "node bin/wilhelm.js app",
    "panel": "node bin/wilhelm.js panel",
    "tray": "node bin/wilhelm.js tray",
    "update-alert": "node bin/wilhelm.js update",
    "face": "node bin/wilhelm.js face",
    "test-alert": "node bin/wilhelm-alert.js --force",
    "log": "node bin/wilhelm-log.js",
    "build": "node bin/wilhelm.js build",
    "postinstall": "node bin/wilhelm-postinstall.js",
    "check": "node test/check.js"
  },
  "files": [
    ".agents",
    ".claude-plugin",
    ".codex-plugin",
    "LICENSE",
    "NOTICE",
    "README.md",
    "app",
    "assets",
    "bin",
    "hooks",
    "integrations",
    "sounds/README.md"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.34.5",
  "bugs": {
    "url": "https://github.com/MaxJafar/wilhelm-alert/issues"
  }
}
