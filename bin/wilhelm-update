#!/usr/bin/env bash
# Pulls the latest wilhelm-alert and re-lands it everywhere it's installed:
# the repo, the compiled binaries, the Mac app, and each agent's plugin cache.
#
#   wilhelm-update           update everything
#   wilhelm-update --check   report the available version, change nothing
#
# Refuses to touch a dirty working tree. Losing someone's uncommitted work to
# a convenience button is not a trade worth making.
set -uo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
remote_manifest="https://raw.githubusercontent.com/MaxJafar/wilhelm-alert/main/package.json"

read_version() {
  node -e "try{process.stdout.write(require('$1').version||'')}catch(e){}" 2>/dev/null
}

local_version="$(read_version "$root_dir/package.json")"

fetch_remote_version() {
  curl -fsSL --max-time 10 "$remote_manifest" 2>/dev/null \
    | node -e "let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{try{process.stdout.write(JSON.parse(s).version||'')}catch(e){}})" 2>/dev/null
}

# Returns 0 when $1 is strictly newer than $2.
version_gt() {
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)" = "$1" ]
}

remote_version="$(fetch_remote_version)"

if [ "${1:-}" = "--check" ]; then
  if [ -z "$remote_version" ]; then
    echo "offline"
  elif version_gt "$remote_version" "$local_version"; then
    echo "update $remote_version"
  else
    echo "current $local_version"
  fi
  exit 0
fi

echo "Local $local_version${remote_version:+, latest $remote_version}"

# ---------------------------------------------------------------- pull

if [ -d "$root_dir/.git" ]; then
  if [ -n "$(git -C "$root_dir" status --porcelain 2>/dev/null)" ]; then
    echo "Uncommitted changes here — not pulling. Commit or stash first, then retry." >&2
    git -C "$root_dir" status --short >&2
    exit 1
  fi

  branch="$(git -C "$root_dir" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  if [ "$branch" = "HEAD" ]; then
    echo "Detached HEAD — not pulling. Check out a branch first." >&2
    exit 1
  fi

  echo "Pulling $branch…"
  if ! git -C "$root_dir" pull --ff-only 2>&1 | sed 's/^/  /'; then
    echo "Pull failed. Resolve it in the repo, then retry." >&2
    exit 1
  fi
  local_version="$(read_version "$root_dir/package.json")"
else
  echo "Not a git checkout, so there's nothing to pull — refreshing what's installed."
fi

# ------------------------------------------------------------- rebuild

echo "Rebuilding…"
"$root_dir/bin/wilhelm-build" overlay >/dev/null 2>&1 && echo "  overlay ok"
"$root_dir/bin/wilhelm-build" settings >/dev/null 2>&1 && echo "  panel ok"

# The bundle holds a *copy* of the panel binary, so a rebuild alone leaves the
# installed app running yesterday's code.
if [ -d "$HOME/Applications/Wilhelm Alert.app" ]; then
  "$root_dir/bin/wilhelm-app" >/dev/null 2>&1 && echo "  Wilhelm Alert.app refreshed"
fi

# -------------------------------------------------------- agent plugins

if command -v claude >/dev/null 2>&1; then
  echo "Claude Code…"
  claude plugin marketplace update wilhelm-alert-marketplace >/dev/null 2>&1
  claude plugin update wilhelm-alert@wilhelm-alert-marketplace 2>&1 \
    | tail -1 | sed 's/^/  /'
fi

if command -v codex >/dev/null 2>&1; then
  echo "Codex…"
  codex plugin marketplace upgrade >/dev/null 2>&1
  codex plugin add wilhelm-alert@wilhelm-alert-marketplace 2>&1 \
    | tail -1 | sed 's/^/  /'
fi

echo
echo "Now on $local_version."
echo "Restart Claude Code to load it. Codex will ask you to approve the hook again"
echo "if hooks/hooks.json changed — its trust is a hash of the hook."
exit 0
