#!/usr/bin/env bash
# Screams when your coding agent finishes a task.
#
# Modes ($WILHELM_ALERT_MODE, default "light"):
#   light   just the scream
#   middle  scream + a popup of the model screaming
#   turbo   scream + popup + the popup shakes aggressively
#
# Which face pops up ($WILHELM_ALERT_SOURCE): claude | codex | <anything>.
# Auto-detected from the agent's own env vars when unset.
#
# Everything here is best-effort and always exits 0 — a missing sound,
# missing image, or missing permission must never break the hook chain of
# the agent that called us.
set -uo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
sounds_dir="$root_dir/sounds"
assets_dir="$root_dir/assets"

config_file="${XDG_CONFIG_HOME:-$HOME/.config}/wilhelm-alert/config"

# Mode comes from the config file, not just the environment: an agent's hook
# runs in the agent's process environment, so an export in your shell profile
# would never reach us. The env var still wins for one-off testing.
read_config() {
  local key="$1"
  [ -f "$config_file" ] || return 0
  sed -n "s/^${key}=//p" "$config_file" | tail -1 | tr -d '[:space:]'
}

mode="${WILHELM_ALERT_MODE:-$(read_config mode)}"
mode="${mode:-light}"
case "$mode" in
  light|middle|turbo) ;;
  *)
    echo "wilhelm-alert: unknown mode '$mode' (want light|middle|turbo), using light" >&2
    mode="light"
    ;;
esac

# Codex sets PLUGIN_ROOT *and* CLAUDE_PLUGIN_ROOT (for plugin compat), so
# check the Codex-only one first or every Codex run would look like Claude.
detect_source() {
  if [ -n "${WILHELM_ALERT_SOURCE:-}" ]; then
    printf '%s' "$WILHELM_ALERT_SOURCE"
  elif [ -n "${PLUGIN_ROOT:-}" ]; then
    printf 'codex'
  elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
    printf 'claude'
  else
    printf 'generic'
  fi
}
source_id="$(detect_source)"

first_match() {
  local f
  for f in "$@"; do
    [ -f "$f" ] && { printf '%s' "$f"; return; }
  done
}

resolve_sound() {
  if [ -n "${WILHELM_ALERT_SOUND:-}" ]; then
    printf '%s' "$WILHELM_ALERT_SOUND"
    return
  fi
  first_match "$sounds_dir"/wilhelm-scream.*
}

resolve_image() {
  local img
  img="$(first_match "$assets_dir/scream-$source_id".*)"
  [ -n "$img" ] || img="$(first_match "$assets_dir/scream-generic".*)"
  printf '%s' "$img"
}

play_sound() {
  local sound="$1"
  case "$(uname -s)" in
    Darwin) afplay "$sound" ;;
    Linux)
      if command -v paplay >/dev/null 2>&1; then paplay "$sound"
      elif command -v aplay >/dev/null 2>&1; then aplay "$sound" >/dev/null 2>&1
      elif command -v ffplay >/dev/null 2>&1; then ffplay -nodisp -autoexit -loglevel quiet "$sound"
      fi
      ;;
  esac
}

show_popup() {
  local img="$1" overlay
  case "$(uname -s)" in
    Darwin)
      # The overlay owns its own window, so turbo can shake it without the
      # Accessibility permission that moving another app's window needs.
      overlay="$("$root_dir/bin/wilhelm-build" overlay 2>/dev/null)"
      if [ -n "$overlay" ] && [ -x "$overlay" ]; then
        "$overlay" --image "$img" --mode "$mode" \
          --seconds "${WILHELM_ALERT_POPUP_SECONDS:-2.4}"
      elif command -v qlmanage >/dev/null 2>&1; then
        # No Swift toolchain: a plain Quick Look panel, no shake.
        qlmanage -p "$img" >/dev/null 2>&1 &
        local ql_pid=$!
        sleep "${WILHELM_ALERT_POPUP_SECONDS:-2.4}"
        kill "$ql_pid" 2>/dev/null
      fi
      ;;
    Linux)
      # No auto-close and no shake — whatever handles images gets it.
      xdg-open "$img" >/dev/null 2>&1
      ;;
  esac
}

# Resolve and complain in the foreground, so the reason for a silent alert
# actually reaches the user; only the playback itself gets detached.
sound="$(resolve_sound)"
if [ -n "$sound" ]; then
  case "$(uname -s)" in
    Darwin|Linux)
      ( play_sound "$sound" >/dev/null 2>&1 & disown ) 2>/dev/null \
        || play_sound "$sound" >/dev/null 2>&1 &
      ;;
    *) echo "wilhelm-alert: unsupported OS $(uname -s), no sound played" >&2 ;;
  esac
else
  echo "wilhelm-alert: no sound file found." >&2
  echo "  Drop one at $sounds_dir/wilhelm-scream.mp3 (or .wav/.aiff)," >&2
  echo "  or set WILHELM_ALERT_SOUND=/path/to/sound.mp3" >&2
fi

if [ "$mode" != "light" ]; then
  image="$(resolve_image)"
  if [ -z "$image" ]; then
    echo "wilhelm-alert: no popup image for '$source_id' — showing nothing." >&2
    echo "  Add one at $assets_dir/scream-$source_id.png (see assets/README.md)" >&2
  else
    ( show_popup "$image" >/dev/null 2>&1 & disown ) 2>/dev/null \
      || show_popup "$image" >/dev/null 2>&1 &
  fi
fi

exit 0
